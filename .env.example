# RefundFish Environment Variables Template
# انسخ هذا الملف إلى .env وأضفها قيم API الحقيقية

# API Keys - استخدم المفاتيح الحقيقية الخاصة بك
TINYFISH_API_KEY=sk-tinyfish-YOUR_KEY_HERE
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE

# Browser Agent Settings - إعدادات وكيل المتصفح
SSE_STREAM_TIMEOUT=120        # أقصى وقت للاتصال SSE (ثانية)
SSE_MAX_WAIT=60               # أقصى وقت الانتظار على البيانات
API_REQUEST_TIMEOUT=30        # timeout لطلبات API
BROWSER_LOAD_TIMEOUT=45       # timeout لتحميل الصفحة

# Price Monitoring Thresholds - عتبات مراقبة الأسعار
MIN_SAVINGS_THRESHOLD=10      # الحد الأدنى للتوفير بالدولار
CANCELLATION_FEE_ESTIMATE=0   # تقدير رسم الإلغاء
REBOOKING_FEE_ESTIMATE=0      # تقدير رسم إعادة الحجز
PRICE_CONFIDENCE_MIN=0.75     # الحد الأدنى لثقة السعر

# Retry Logic - منطق إعادة المحاولة
MAX_RETRIES=3                 # أقصى عدد محاولات
RETRY_BACKOFF_FACTOR=2        # عامل التأخير الأسي
INITIAL_RETRY_DELAY=1         # التأخير الأول (ثانية)

# Logging - إعدادات السجلات
LOG_LEVEL=INFO                # مستويات: DEBUG, INFO, WARNING, ERROR

# Caching - الذاكرة المؤقتة
ENABLE_CACHE=true             # تفعيل تخزين النتائج مؤقتاً
CACHE_EXPIRY_MINUTES=30       # صلاحية الذاكرة المؤقتة

